<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

    <f:entry title="${%Template Name}" field="templateName">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Labels}" field="labels" help="/help/system-config/master-slave/labels.html">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Remote FS root}" field="remoteFS">
        <f:textbox default="/tmp" />
    </f:entry>

    <f:entry title="${%# of executors}" field="numExecutors">
        <f:textbox default="1" />
    </f:entry>

    <f:entry title="${%Datacenter Node}" field="datacenterNode">
        <f:select />
    </f:entry>

    <f:entry title="${%Template VM ID}" field="templateVmId">
        <f:select fillDependsOn="datacenterNode" />
    </f:entry>

    <f:entry title="${%Snapshot Name}" field="snapshotName">
        <f:select fillDependsOn="datacenterNode,templateVmId" />
    </f:entry>

    <f:validateButton title="${%Check Template VM Status}" progress="${%Checking status...}" method="checkTemplateVMStatus"
                      with="datacenterNode,templateVmId"/>

    <f:entry title="${%Instance Cap}" field="instanceCap">
        <f:number default="10" clazz="number" min="0" step="1"/>
    </f:entry>

    <f:entry title="${%Max Idle Minutes}" field="maxIdleMinutes">
        <f:number default="30" clazz="number" min="0" step="1"/>
    </f:entry>

    <f:entry title="${%Start VM}" field="startVM">
        <f:checkbox default="true" />
    </f:entry>

    <f:entry title="${%Startup Waiting Period (seconds)}" field="startupWaitingPeriodSeconds">
        <f:number default="60" clazz="number" min="0" step="1"/>
    </f:entry>

    <f:entry title="${%Revert Policy}" field="revertPolicy" help="/plugin/proxmox/help-vm-revertPolicy.html">
        <f:enum field="revertPolicy">
            ${it.getLabel()}
        </f:enum>
    </f:entry>

    <f:dropdownList name="launcher" title="${%Launch method}" 
                    help="/help/system-config/master-slave/launcher.html">
        <j:forEach var="descriptor" items="${h.getComputerLauncherDescriptors()}">
            <f:dropdownListBlock value="${descriptor.clazz.name}" name="${descriptor.displayName}"
                               selected="${it.launcher.descriptor==descriptor}"
                               title="${descriptor.displayName}">
                <j:set var="instance" value="${it.launcher.descriptor==descriptor ? it.launcher : null}"/>
                <st:include from="${descriptor}" page="${descriptor.configPage}" optional="true"/>
            </f:dropdownListBlock>
        </j:forEach>
    </f:dropdownList>

    <f:dropdownList name="retentionStrategy" title="${%Availability}"
                    help="/help/system-config/master-slave/availability.html">
        <j:forEach var="descriptor" items="${h.getRetentionStrategyDescriptors()}">
            <f:dropdownListBlock value="${descriptor.clazz.name}" name="${descriptor.displayName}"
                               selected="${it.retentionStrategy.descriptor==descriptor}"
                               title="${descriptor.displayName}">
                <j:set var="instance" value="${it.retentionStrategy.descriptor==descriptor ? it.retentionStrategy : null}"/>
                <st:include from="${descriptor}" page="${descriptor.configPage}" optional="true"/>
            </f:dropdownListBlock>
        </j:forEach>
    </f:dropdownList>

    <f:descriptorList title="${%Node Properties}" descriptors="${h.getNodePropertyDescriptors(it.class)}"
                      field="nodeProperties"/>

</j:jelly>