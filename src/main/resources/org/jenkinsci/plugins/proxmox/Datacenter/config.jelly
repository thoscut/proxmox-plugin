<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form" xmlns:c="/lib/credentials">

    <f:entry title="${%Proxmox VE Hostname}" field="hostname"
             help="${descriptor.getHelpFile('hostname')}">
        <f:textbox placeholder="proxmox.example.com or proxmox.example.com:8006"/>
    </f:entry>

    <f:entry title="${%Credentials}" field="credentialsId"
             help="${descriptor.getHelpFile('credentialsId')}">
        <c:select includeUser="false" />
    </f:entry>

    <f:entry title="${%Authentication Realm}" field="realm"
             help="${descriptor.getHelpFile('realm')}">
        <f:textbox default="pve" placeholder="pve"/>
    </f:entry>

    <f:validateButton title="${%Test Connection}" progress="${%Testing...}"
                      method="testConnection"
                      with="hostname,credentialsId,realm,ignoreSSL"/>

    <f:entry title="${%Instance Cap}" field="instanceCap"
             help="${descriptor.getHelpFile('instanceCap')}">
        <f:number default="10" clazz="number" min="0" step="1"/>
        <f:description>
            Maximum number of VMs across all templates. Set to 0 for unlimited.
        </f:description>
    </f:entry>

    <f:advanced title="${%Advanced Settings}">
        <f:entry title="${%Ignore SSL Certificate Errors}" field="ignoreSSL"
                 help="${descriptor.getHelpFile('ignoreSSL')}">
            <f:checkbox default="false" />
            <f:description>
                <strong style="color: #d04437;">Warning:</strong> Only enable for testing with self-signed certificates.
            </f:description>
        </f:entry>
    </f:advanced>

    <f:repeatableProperty field="templates" header="${%Agent Templates}"
                         addCaption="${%Add Agent Template}"/>

</j:jelly>
