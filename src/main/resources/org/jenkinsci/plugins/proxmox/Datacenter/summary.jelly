<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
  <st:adjunct includes="org.jenkinsci.plugins.proxmox.Datacenter"/>
  
  <div class="pane" style="padding: 10px; margin: 5px 0;">
    <h3 style="margin-top: 0; color: #333;">
      <img src="${resURL}/plugin/proxmox/images/proxmox-icon.png" alt="Proxmox" style="width: 16px; height: 16px; vertical-align: middle; margin-right: 5px;" onerror="this.style.display='none'"/>
      Proxmox Cloud: ${it.datacenterDescription}
    </h3>
    
    <div style="margin-left: 20px;">
      <j:set var="stats" value="${it.statistics}"/>
      
      <!-- Connection Status -->
      <div style="margin-bottom: 10px;">
        <strong>Status:</strong>
        <j:choose>
          <j:when test="${stats.datacenterReachable}">
            <span style="color: green;">🟢 Connected</span>
          </j:when>
          <j:otherwise>
            <span style="color: red;">🔴 Disconnected</span>
            <j:if test="${!empty(stats.lastErrorMessage)}">
              - ${stats.lastErrorMessage}
            </j:if>
          </j:otherwise>
        </j:choose>
      </div>
      
      <!-- Capacity Information -->
      <div style="margin-bottom: 10px;">
        <strong>Capacity:</strong>
        ${stats.currentSlaveCount}/${it.instanceCap} slaves
        (<j:set var="available" value="${it.instanceCap - stats.currentSlaveCount}"/>
        <j:choose>
          <j:when test="${available > 0}">
            <span style="color: green;">${available} available</span>
          </j:when>
          <j:otherwise>
            <span style="color: orange;">at capacity</span>
          </j:otherwise>
        </j:choose>)
      </div>
      
      <!-- Slave Status -->
      <div style="margin-bottom: 10px;">
        <strong>Slaves:</strong>
        <span style="color: green;">${stats.onlineSlaves} online</span>,
        <j:if test="${stats.offlineSlaves > 0}">
          <span style="color: red;">${stats.offlineSlaves} offline</span>,
        </j:if>
        <j:if test="${stats.temporarilyOfflineSlaves > 0}">
          <span style="color: orange;">${stats.temporarilyOfflineSlaves} temp-offline</span>,
        </j:if>
        <j:if test="${stats.provisioningSlaves > 0}">
          <span style="color: blue;">${stats.provisioningSlaves} provisioning</span>
        </j:if>
      </div>
      
      <!-- Provisioning Statistics -->
      <j:if test="${stats.totalProvisioningAttempts > 0}">
        <div style="margin-bottom: 10px;">
          <strong>Provisioning:</strong>
          <j:set var="successRate" value="${stats.successRate}"/>
          <j:choose>
            <j:when test="${successRate >= 90}">
              <span style="color: green;">${successRate}% success rate</span>
            </j:when>
            <j:when test="${successRate >= 70}">
              <span style="color: orange;">${successRate}% success rate</span>
            </j:when>
            <j:otherwise>
              <span style="color: red;">${successRate}% success rate</span>
            </j:otherwise>
          </j:choose>
          (${stats.successfulProvisionings}/${stats.totalProvisioningAttempts} attempts)
          <j:if test="${stats.averageProvisioningTimeMs > 0}">
            <br/><small>&#160;&#160;&#160;&#160;Average time: ${stats.averageProvisioningTimeMs}ms</small>
          </j:if>
        </div>
      </j:if>
      
      <!-- Node Health -->
      <j:set var="nodeHealthMap" value="${stats.nodeHealthMap}"/>
      <j:if test="${!nodeHealthMap.isEmpty()}">
        <div style="margin-bottom: 10px;">
          <strong>Nodes:</strong>
          <j:set var="onlineNodes" value="0"/>
          <j:set var="totalNodes" value="${nodeHealthMap.size()}"/>
          <j:forEach var="health" items="${nodeHealthMap.values()}">
            <j:if test="${health.online}">
              <j:set var="onlineNodes" value="${onlineNodes + 1}"/>
            </j:if>
          </j:forEach>
          ${onlineNodes}/${totalNodes} online
          
          <div style="margin-left: 15px; margin-top: 5px;">
            <j:forEach var="nodeEntry" items="${nodeHealthMap.entrySet()}">
              <j:set var="health" value="${nodeEntry.value}"/>
              <div style="font-size: 11px; margin: 2px 0;">
                • ${health.nodeName}:
                <j:choose>
                  <j:when test="${health.online}">
                    <span style="color: green;">🟢 Online</span>
                    (CPU: <j:choose>
                      <j:when test="${health.cpuUsage > 90}"><span style="color: red;">${health.cpuUsage}%</span></j:when>
                      <j:when test="${health.cpuUsage > 70}"><span style="color: orange;">${health.cpuUsage}%</span></j:when>
                      <j:otherwise>${health.cpuUsage}%</j:otherwise>
                    </j:choose>,
                    RAM: <j:choose>
                      <j:when test="${health.memoryUsage > 90}"><span style="color: red;">${health.memoryUsage}%</span></j:when>
                      <j:when test="${health.memoryUsage > 70}"><span style="color: orange;">${health.memoryUsage}%</span></j:when>
                      <j:otherwise>${health.memoryUsage}%</j:otherwise>
                    </j:choose>,
                    VMs: ${health.runningVMs})
                  </j:when>
                  <j:otherwise>
                    <span style="color: red;">🔴 ${health.status}</span>
                  </j:otherwise>
                </j:choose>
              </div>
            </j:forEach>
          </div>
        </div>
      </j:if>
      
      <!-- Last Updated -->
      <div style="font-size: 10px; color: #666; margin-top: 10px;">
        <j:if test="${!empty(stats.lastHealthCheck)}">
          Last updated: ${stats.lastHealthCheck}
        </j:if>
      </div>
      
      <!-- Action Buttons -->
      <div style="margin-top: 10px;">
        <button onclick="location.reload()" style="font-size: 11px; padding: 2px 8px;">Refresh</button>
        <j:if test="${app.hasPermission(app.ADMINISTER)}">
          <button onclick="showDetailedStats('${it.datacenterDescription}')" style="font-size: 11px; padding: 2px 8px; margin-left: 5px;">Detailed Stats</button>
          <a href="status/" style="font-size: 11px; padding: 2px 8px; margin-left: 5px; text-decoration: none; border: 1px solid #ccc; background: #f9f9f9; color: #333;">Status Page</a>
        </j:if>
      </div>
    </div>
  </div>
  
  <script type="text/javascript">
    function showDetailedStats(datacenterDescription) {
      var xhr = new XMLHttpRequest();
      xhr.open('POST', '${rootURL}/descriptorByName/org.jenkinsci.plugins.proxmox.Datacenter/getDetailedStatistics', true);
      xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
      xhr.onload = function() {
        if (xhr.status === 200) {
          var response = xhr.responseText;
          var popup = window.open('', 'ProxmoxStats', 'width=800,height=600,scrollbars=yes,resizable=yes');
          popup.document.write('<html><head><title>Proxmox Cloud Statistics</title></head><body><pre style="font-family: monospace; font-size: 12px; white-space: pre-wrap; margin: 10px;">' + response + '</pre></body></html>');
          popup.document.close();
        } else {
          alert('Failed to get detailed statistics: ' + xhr.responseText);
        }
      };
      xhr.send('datacenterDescription=' + encodeURIComponent(datacenterDescription));
    }
  </script>
</j:jelly>