<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

  <l:layout title="Proxmox Datacenter Status: ${it.datacenterDescription}" permission="${app.READ}">
    <l:side-panel>
      <l:tasks>
        <l:task icon="icon-notepad icon-md" href="." title="Status" />
        <l:task icon="icon-gear icon-md" href="configure" title="Configure" permission="${app.ADMINISTER}" />
        <l:task icon="icon-edit-delete icon-md" href="doDelete" title="Delete Cloud" permission="${app.ADMINISTER}" post="true" requiresConfirmation="true" />
        <j:if test="${app.hasPermission(app.ADMINISTER)}">
          <l:task icon="icon-clipboard icon-md" href="status" title="Extended Status" permission="${app.ADMINISTER}" />
        </j:if>
      </l:tasks>
    </l:side-panel>
    <l:main-panel>
      <h1>Proxmox Datacenter - Detailed Status</h1>
      
      <h2>Configuration</h2>
      <table class="pane bigtable">
        <tr>
          <td>Datacenter Description:</td>
          <td>${it.datacenterDescription}</td>
        </tr>
        <tr>
          <td>Hostname:</td>
          <td>${it.hostname}</td>
        </tr>
        <tr>
          <td>Username:</td>
          <td>${it.username}@${it.realm}</td>
        </tr>
        <tr>
          <td>Ignore SSL:</td>
          <td>${it.ignoreSSL ? 'Yes' : 'No'}</td>
        </tr>
        <tr>
          <td>Instance Cap:</td>
          <td>${it.instanceCap}</td>
        </tr>
      </table>

      <j:if test="${!it.templates.isEmpty()}">
        <h2>Cloud Templates</h2>
        <table class="pane bigtable">
          <tr>
            <th>Template Description</th>
            <th>Template VM ID</th>
            <th>Node</th>
            <th>Instance Cap</th>
            <th>Linked Clone</th>
          </tr>
          <j:forEach var="template" items="${it.templates}">
            <tr>
              <td>${template.templateDescription}</td>
              <td>${template.templateVmId}</td>
              <td>${template.datacenterNode}</td>
              <td>${template.instanceCap}</td>
              <td>${template.linkedClone ? 'Yes' : 'No'}</td>
            </tr>
          </j:forEach>
        </table>
      </j:if>

      <h2>Connection Status</h2>
      <j:set var="nodes" value="${it.nodes}"/>
      <j:choose>
        <j:when test="${!nodes.isEmpty()}">
          <p style="color: green;">✓ Connected to Proxmox cluster</p>
          <table class="pane bigtable">
            <tr>
              <th>Available Nodes</th>
            </tr>
            <j:forEach var="node" items="${nodes}">
              <tr>
                <td>${node}</td>
              </tr>
            </j:forEach>
          </table>
        </j:when>
        <j:otherwise>
          <p style="color: red;">✗ Unable to connect to Proxmox cluster</p>
          <p>Please check your connection settings and credentials.</p>
        </j:otherwise>
      </j:choose>

      <h2>Cloud Statistics</h2>
      <j:set var="stats" value="${it.statistics}"/>
      <table class="pane bigtable">
        <tr>
          <td>Current Slaves:</td>
          <td>${stats.currentSlaveCount}</td>
        </tr>
        <tr>
          <td>Total Provisioning Attempts:</td>
          <td>${stats.totalProvisioningAttempts}</td>
        </tr>
        <tr>
          <td>Successful Provisionings:</td>
          <td>${stats.successfulProvisionings}</td>
        </tr>
        <tr>
          <td>Success Rate:</td>
          <td>${stats.successRate}%</td>
        </tr>
        <tr>
          <td>Last Check:</td>
          <td>${stats.lastHealthCheckTime}</td>
        </tr>
        <tr>
          <td>Datacenter Reachable:</td>
          <td>${stats.datacenterReachable ? 'Yes' : 'No'}</td>
        </tr>
      </table>


    </l:main-panel>
  </l:layout>
</j:jelly>