<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

    <f:entry title="${%Datacenter}" field="datacenterDescription">
        <f:select />
    </f:entry>

    <f:entry title="${%Node}" field="datacenterNode">
        <f:select />
    </f:entry>

    <f:entry title="${%Source VM ID}" field="vmId">
        <f:select />
    </f:entry>

    <f:entry title="${%Target VM ID}" field="targetVmId">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Clone Name}" field="cloneName">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Start After Clone}" field="startAfterClone">
        <f:checkbox default="false" />
    </f:entry>

    <f:entry title="${%Snapshot Name (optional)}" field="snapshotName">
        <f:textbox />
    </f:entry>

</j:jelly>
