<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

    <f:entry title="${%Datacenter}" field="datacenterDescription">
        <f:select />
    </f:entry>

    <f:entry title="${%Node}" field="datacenterNode">
        <f:select />
    </f:entry>

    <f:entry title="${%VM ID}" field="vmId">
        <f:select />
    </f:entry>

    <f:entry title="${%Snapshot Name}" field="snapshotName">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Description}" field="description">
        <f:textbox />
    </f:entry>

    <f:entry title="${%Include RAM}" field="includeRam">
        <f:checkbox default="false" />
    </f:entry>

</j:jelly>
